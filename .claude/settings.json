{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-sync.sh\"",
            "timeout": 60,
            "statusMessage": "Git-Stand mit GitHub abgleichen..."
          }
        ]
      }
    ]
  }
}
